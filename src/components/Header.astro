---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-authority/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex items-center gap-3 font-display text-xl font-bold tracking-tight text-canvas">
      <img src="/images/penpixel-icon.webp" alt="Penpixel Creative" width="28" height="28" loading="eager" />
      <span>Penpixel <span class="text-canvas/50">Creative</span></span>
    </a>

    <!-- Desktop nav. Resources is a CSS-only dropdown (hover/focus-within), no JS, so the strict CSP holds. -->
    <nav class="flex items-center gap-6 text-sm" aria-label="Primary">
      {NAV.map((item) => (
        'children' in item ? (
          <div class="group relative hidden sm:block">
            <button
              type="button"
              class:list={[
                'flex items-center gap-1 font-body transition-colors hover:text-canvas group-focus-within:text-canvas group-hover:text-canvas',
                item.children.some((c) => isActive(c.href)) ? 'text-canvas' : 'text-canvas/60',
              ]}
            >
              {item.label}
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4l4 4 4-4" /></svg>
            </button>
            <div class="invisible absolute left-0 top-full z-50 min-w-56 pt-3 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
              <div class="border border-white/10 bg-authority py-2">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    aria-current={isActive(child.href) ? 'page' : undefined}
                    class:list={[
                      'block px-4 py-2 font-body transition-colors hover:bg-white/5 hover:text-canvas',
                      isActive(child.href) ? 'text-canvas' : 'text-canvas/70',
                    ]}
                  >{child.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'hidden font-body transition-colors hover:text-canvas sm:inline',
              isActive(item.href) ? 'text-canvas' : 'text-canvas/60',
            ]}
          >{item.label}</a>
        )
      ))}
      <a
        href="/contact"
        class="hidden bg-impact-bg px-4 py-2 font-display text-sm font-bold text-canvas transition-opacity hover:opacity-90 sm:inline"
      >Get the Diagnosis</a>

      <!-- Mobile menu toggle: sm:hidden, only ever shown below the breakpoint -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
        class="-mr-2 flex h-11 w-11 items-center justify-center text-canvas sm:hidden"
      >
        <svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile nav panel: hidden by default, toggled by mobile-nav.js. sm:hidden as a hard backstop
       so it can never show on desktop even if JS state gets out of sync. -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-white/10 bg-authority sm:hidden"
    aria-label="Mobile"
  >
    <div class="flex flex-col px-6 py-4">
      {NAV.map((item) => (
        'children' in item ? (
          <div class="border-b border-white/10 py-4">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-canvas/50">{item.label}</p>
            <div class="mt-2 flex flex-col">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  aria-current={isActive(child.href) ? 'page' : undefined}
                  class:list={[
                    'py-3 pl-4 font-body text-base',
                    isActive(child.href) ? 'text-canvas' : 'text-canvas/70',
                  ]}
                >{child.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'border-b border-white/10 py-4 font-body text-base',
              isActive(item.href) ? 'text-canvas' : 'text-canvas/70',
            ]}
          >{item.label}</a>
        )
      ))}
      <a
        href="/contact"
        class="mt-4 bg-impact-bg px-4 py-3 text-center font-display text-sm font-bold text-canvas"
      >Get the Diagnosis</a>
    </div>
  </nav>
</header>

<script is:inline src="/js/mobile-nav.js" defer></script>
