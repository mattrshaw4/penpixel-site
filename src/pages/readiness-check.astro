---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
// Working title. Final product name is Deven's call (see plan doc: naming is an
// open decision). The slug /readiness-check is neutral; add a redirect if the
// final name wants a different one.
---
<BaseLayout
  title="AEO Readiness Check | Can AI Actually Read Your Site?"
  description="Free single-URL scan. See whether the crawlers behind ChatGPT, Perplexity, Claude, and Gemini can read, parse, and cite your site."
>
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-6 pt-20 pb-12 md:pt-28">
      <p class="font-mono text-sm uppercase tracking-[0.2em] text-impact">// run the check</p>
      <h1 class="mt-5 max-w-4xl text-5xl md:text-6xl">Can AI actually read your site?</h1>
      <p class="mt-6 max-w-2xl text-lg text-canvas/80">
        Most B2B SaaS sites have never been checked against the crawlers that
        decide AI citations. This scan checks yours in seconds, against the
        access rules those crawlers actually follow.
      </p>
    </section>

    <!-- The form -->
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <form id="scan-form" method="post" action="/api/scan" class="max-w-2xl" novalidate>
          <label class="block">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-canvas/50">Your site *</span>
            <input name="url" type="text" required maxlength="2000" autocomplete="url" inputmode="url"
              class="mt-2 w-full border border-white/20 bg-white/[0.03] px-4 py-3 font-mono text-canvas placeholder:text-canvas/30 focus:border-impact focus:outline-none"
              placeholder="yourcompany.com" />
          </label>

          <!-- Turnstile widget: verified server-side; this is the bot gate. -->
          <div class="cf-turnstile mt-5" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div>

          <div class="mt-5 flex flex-wrap items-center gap-5">
            <button type="submit"
              class="bg-impact px-8 py-4 font-display text-lg font-bold text-canvas transition-opacity hover:opacity-90 disabled:opacity-40">
              Run the check
            </button>
            <p id="scan-status" role="status" aria-live="polite" class="font-mono text-sm text-canvas/60"></p>
          </div>

          <!-- GATE HOOK: when the email gate is finalized (Deven's call), the
               capture field mounts here and the API enforces it server-side. -->
        </form>
      </div>
    </section>

    <!-- Results: hidden until a scan completes; populated by /js/readiness-check.js -->
    <section id="results" class="hidden border-t border-white/10" aria-live="polite">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-canvas/50">// machine readout</p>
        <div id="results-body" class="mt-6"></div>
        <div class="mt-12 border border-white/15 bg-white/[0.02] p-8 max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-canvas/50">// what now</p>
          <h2 class="mt-3 text-2xl">A score tells you where you stand. It doesn&rsquo;t fix anything.</h2>
          <p class="mt-3 text-canvas/70">
            The full audit goes where a scan can&rsquo;t: your entity graph, your
            citation record, and what the gap is costing you. That&rsquo;s the work.
          </p>
          <a href={SITE.booking} target="_blank" rel="noopener noreferrer"
            class="mt-6 inline-block border border-white/30 px-6 py-3 font-display font-bold text-canvas transition-colors hover:border-impact">
            Book a call
          </a>
        </div>
      </div>
    </section>

    <!-- What this measures: Deven's requirement: define it upfront, plainly. -->
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-canvas/50">// what this measures</p>
        <h2 class="mt-3 max-w-3xl text-3xl">Three things decide whether AI can cite you. This checks all three.</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-3">
          <div class="border-t-2 border-infra pt-5">
            <h3 class="text-xl">Crawl access</h3>
            <p class="mt-3 text-canvas/70">
              Whether the crawlers behind ChatGPT, Perplexity, Claude, and Gemini
              are allowed to read your site at all. Blocking a training bot is a
              choice. Blocking a citation bot is a self-inflicted wound, and most
              teams doing it don&rsquo;t know they are.
            </p>
          </div>
          <div class="border-t-2 border-ai pt-5">
            <h3 class="text-xl">Structured data</h3>
            <p class="mt-3 text-canvas/70">
              Whether your pages carry valid machine-readable markup. AI systems
              lean on structure over prose. No valid schema means the machine is
              guessing at what your company is.
            </p>
          </div>
          <div class="border-t-2 border-success pt-5">
            <h3 class="text-xl">Delivery speed</h3>
            <p class="mt-3 text-canvas/70">
              Whether your pages arrive fast enough to be read. AI crawlers give
              up in seconds and largely don&rsquo;t run your JavaScript. A slow,
              client-rendered page is an empty page to a machine.
            </p>
          </div>
        </div>
        <p class="mt-10 max-w-2xl text-sm text-canvas/60">
          This scan reports what is publicly fetchable. Some sites serve
          different responses to different crawlers; where we can&rsquo;t read a
          file, the readout says so instead of guessing.
        </p>
      </div>
    </section>
  </main>

  <!-- Turnstile loader (external, from Cloudflare, allowed in CSP) -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script is:inline src="/js/readiness-check.js" defer></script>
</BaseLayout>
